# Tailoring/ranking runs on a local Ollama model, no key needed.
# Requires `ollama serve` running with the model pulled (default: qwen3:8b).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Free tier at tavily.com, used for the Search tab (no card required to sign up)
TAVILY_API_KEY=tvly-...

PORT=3001
# Time of day (24h, server local time) the daily auto-search/tailor run fires
ACR_DAILY_TIME=08:00
